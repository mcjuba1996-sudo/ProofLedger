{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest.json",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "base_currency",
    "period_start",
    "period_end",
    "timezone",
    "counts",
    "rounding"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "base_currency": {
      "enum": [
        "KZT",
        "USD",
        "EUR"
      ]
    },
    "period_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "pattern": "^[+-]\\d{2}:\\d{2}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "ledger_rows",
        "invoices",
        "payments",
        "fx_rates"
      ]
    },
    "rounding": {
      "type": "object",
      "required": [
        "mode",
        "minor_unit_exponent"
      ]
    }
  }
}
