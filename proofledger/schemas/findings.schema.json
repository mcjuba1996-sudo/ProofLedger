{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings.json (submit payload)",
  "type": "object",
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "type",
        "affected_ids",
        "claimed_amount_minor",
        "currency",
        "evidence_ids",
        "explanation"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "affected_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimed_amount_minor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
