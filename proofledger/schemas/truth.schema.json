{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth.json (closed)",
  "type": "object",
  "required": [
    "episode_id",
    "issues"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "canary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "type",
          "affected_ids",
          "expected_amount_minor",
          "currency",
          "evidence_sets"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_error",
              "period_error"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_amount_minor": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "enum": [
              "KZT",
              "USD",
              "EUR"
            ]
          },
          "tolerance_minor": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
